# Hugging Face token (optional, but raises ZeroGPU quota)
# Get one free at https://huggingface.co/settings/tokens
HF_TOKEN=

# Default voice for edge-tts
CHIMERA_VOICE=en-US-AriaNeural

# Default resolution
CHIMERA_RESOLUTION=1080p

# Cache directory
CHIMERA_CACHE_DIR=.chimera_cache

# Temp directory
CHIMERA_TMP_DIR=.chimera_tmp
